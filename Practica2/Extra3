/* Extra 3 - Temperature threshold alarm
 * D = set a four-digit limit in tenths of a degree C (0300 = 30.0 C).
 * # = save and * = cancel while setting the limit.
 */

#include "monitoring_drivers.h"

void buzzer_tone_burst(void)
{
    unsigned char cycle;

    for (cycle = 0; cycle < 50u; cycle++)
    {
        PTB->PSOR = (1u << 8);
        delay_ms(1);
        PTB->PCOR = (1u << 8);
        delay_ms(1);
    }
}

int main(void)
{
    unsigned int threshold = 300;
    unsigned int entered_threshold;
    unsigned char setting = 0;
    unsigned char digits[4];
    unsigned char count = 0;
    unsigned char limit_exceeded;
    unsigned char displayed_warning = 0xFFu;
    int temperature;
    char key;

    I2C1_init();
    LCD_init();
    SPI0_init();
    MAX7219_init();
    keypad_init();
    alarm_gpio_init();

    while (1)
    {
        RTC_read();
        temperature = TMP102_read();
        MAX7219_time();
        key = keypad_key();

        limit_exceeded = (temperature >= (int)threshold);

        if (limit_exceeded)
        {
            PTB->PCOR = (1u << 18);         /* Red LED is active-low. */
            PTB->PSOR = (1u << 19);
            PTD->PSOR = (1u << 1);
            buzzer_tone_burst();
        }
        else
        {
            PTB->PCOR = (1u << 8);
            PTB->PSOR = (1u << 18) | (1u << 19);
            PTD->PSOR = (1u << 1);
        }

        if (!setting)
        {
            LCD_command(0x80);
            LCD_text("Temp: ");
            LCD_temperature(temperature);
            LCD_text("       ");

            if (displayed_warning != limit_exceeded)
            {
                LCD_command(0xC0);
                if (limit_exceeded)
                    LCD_text("WARNING! D=set  ");
                else
                    LCD_text("Normal   D=set  ");

                displayed_warning = limit_exceeded;
            }

            if (key == 'D')
            {
                setting = 1;
                count = 0;
                displayed_warning = 0xFFu;
                LCD_command(0x01);
                LCD_command(0x80);
                LCD_text("Limit x10 # save");
                LCD_input(digits, count);
            }
        }
        else
        {
            if ((key >= '0') && (key <= '9') && (count < 4u))
            {
                digits[count] = (unsigned char)(key - '0');
                count++;
                LCD_input(digits, count);
            }
            else if (key == '*')
            {
                setting = 0;
                count = 0;
                displayed_warning = 0xFFu;
                LCD_command(0x01);
            }
            else if ((key == '#') && (count == 4u))
            {
                entered_threshold = digits[0] * 1000u +
                                    digits[1] * 100u +
                                    digits[2] * 10u +
                                    digits[3];

                if (entered_threshold <= 999u)
                {
                    threshold = entered_threshold;
                    setting = 0;
                    count = 0;
                    displayed_warning = 0xFFu;
                    LCD_command(0x01);
                }
                else
                {
                    count = 0;
                    LCD_command(0x80);
                    LCD_text("Range 0000-0999");
                    LCD_input(digits, count);
                }
            }
        }

        if (!limit_exceeded)
            delay_ms(50);
    }
}
