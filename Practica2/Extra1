/* Extra 1 - I2C LCD interface
 * LCD PCF8574 address: 0x27
 * Uses the same PTC1/PTC2 bus as the DS3231 and TMP102.
 */

#include "monitoring_drivers.h"

void show_temperature_i2c(int temperature)
{
    unsigned int value;

    if (temperature < 0)
    {
        LCDI2C_data('-');
        value = (unsigned int)(-temperature);
    }
    else
    {
        value = (unsigned int)temperature;
    }

    LCDI2C_data((value / 100u) + '0');
    LCDI2C_data(((value / 10u) % 10u) + '0');
    LCDI2C_data('.');
    LCDI2C_data((value % 10u) + '0');
    LCDI2C_data('C');
}

int main(void)
{
    int temperature;

    I2C1_init();
    LCDI2C_init();
    SPI0_init();
    MAX7219_init();

    while (1)
    {
        RTC_read();
        temperature = TMP102_read();
        MAX7219_time();

        LCDI2C_command(0x80);
        LCDI2C_two(rtc_date);
        LCDI2C_data('/');
        LCDI2C_two(rtc_month);
        LCDI2C_data('/');
        LCDI2C_two(rtc_year);
        LCDI2C_data(' ');
        LCDI2C_two(rtc_hour);
        LCDI2C_data(':');
        LCDI2C_two(rtc_minute);
        LCDI2C_text("  ");

        LCDI2C_command(0xC0);
        LCDI2C_text("Temp: ");
        show_temperature_i2c(temperature);
        LCDI2C_text("     ");

        delay_ms(200);
    }
}
