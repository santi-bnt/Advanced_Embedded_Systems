/* Exercise 6 - Complete monitoring station
 * A = set time
 * B = set date
 * C = set alarm
 * D = enable/disable alarm
 * # = confirm/stop
 * * = cancel
 */

#include "monitoring_drivers.h"

#define NORMAL_MODE  0
#define TIME_MODE    1
#define DATE_MODE    2
#define ALARM_MODE   3

void show_normal_screen(int temperature)
{
    LCD_command(0x80);

    LCD_two(rtc_date);
    LCD_data('/');
    LCD_two(rtc_month);
    LCD_data('/');
    LCD_two(rtc_year);

    LCD_data(' ');

    LCD_two(rtc_hour);
    LCD_data(':');
    LCD_two(rtc_minute);

    LCD_text("  ");

    LCD_command(0xC0);

    LCD_text("T:");
    LCD_temperature(temperature);

    LCD_text(" A:");

    if (alarm_enabled)
        LCD_text("ON ");
    else
        LCD_text("OFF");
}


int main(void)
{
    unsigned char mode = NORMAL_MODE;

    unsigned char digits[6];
    unsigned char count = 0;

    unsigned char alarm_hour = 7;
    unsigned char alarm_minute = 30;

    unsigned char value1;
    unsigned char value2;
    unsigned char value3;

    unsigned char status = 0;
    unsigned char alarm_screen = 0;
    unsigned char tone_cycle;

    int temperature;

    char key;


    I2C1_init();
    LCD_init();

    SPI0_init();
    MAX7219_init();

    keypad_init();

    alarm_gpio_init();


    while (1)
    {
        if (alarm_active)
        {
            if (!alarm_screen)
            {
                LCD_command(0x80);
                LCD_text("*** ALARM ***   ");
                LCD_command(0xC0);
                LCD_text("Press # to stop ");
                alarm_screen = 1;
            }

            for (tone_cycle = 0; tone_cycle < 10u; tone_cycle++)
            {
                PTB->PSOR = (1u << 8);
                delay_ms(1);
                PTB->PCOR = (1u << 8);
                delay_ms(1);
            }

            key = keypad_key();
            if (key == '#')
            {
                RTC_alarm_clear();
                alarm_screen = 0;
                mode = NORMAL_MODE;
                LCD_command(0x01);
            }

            continue;
        }

        alarm_screen = 0;

        /* ---------------- READ DEVICES ---------------- */

        RTC_read();

        temperature = TMP102_read();

        MAX7219_time();

        key = keypad_key();


        /* ---------------- CHECK RTC ALARM ---------------- */

        I2C_read(
            DS3231_ADDRESS,
            0x0F,
            &status,
            1
        );

        /* A1F = Alarm 1 flag */
        if (status & 0x01)
        {
            alarm_active = 1;

            /* Red LED ON */
            PTB->PCOR = (1u << 18);

            /* Green OFF */
            PTB->PSOR = (1u << 19);

            /* Blue OFF */
            PTD->PSOR = (1u << 1);
        }

        if (alarm_active)
        {
            continue;
        }

        /* =================================================
         * NORMAL MODE
         * ================================================= */

        if (mode == NORMAL_MODE)
        {
            show_normal_screen(temperature);


            /* ---------- SET TIME ---------- */

            if (key == 'A')
            {
                mode = TIME_MODE;

                count = 0;

                LCD_command(0x01);

                LCD_command(0x80);
                LCD_text("SET TIME HHMM");
            }


            /* ---------- SET DATE ---------- */

            else if (key == 'B')
            {
                mode = DATE_MODE;

                count = 0;

                LCD_command(0x01);

                LCD_command(0x80);
                LCD_text("SET DATE DDMMYY");
            }


            /* ---------- SET ALARM ---------- */

            else if (key == 'C')
            {
                mode = ALARM_MODE;

                count = 0;

                LCD_command(0x01);

                LCD_command(0x80);
                LCD_text("SET ALARM HHMM");
            }


            /* ---------- ENABLE / DISABLE ALARM ---------- */

            else if (key == 'D')
            {
                if (alarm_enabled)
                {
                    RTC_alarm_clear();

                    RTC_alarm_enable(0);
                }
                else
                {
                    RTC_alarm_set(
                        alarm_hour,
                        alarm_minute
                    );
                }

                LCD_command(0x01);
            }
        }


        /* =================================================
         * CONFIGURATION MODE
         * ================================================= */

        else
        {
            /* ---------- ENTER DIGITS ---------- */

            if ((key >= '0') && (key <= '9'))
            {
                if (
                    (mode == DATE_MODE && count < 6u) ||
                    (mode != DATE_MODE && count < 4u)
                   )
                {
                    digits[count] =
                        (unsigned char)(key - '0');

                    count++;

                    LCD_input(
                        digits,
                        count
                    );
                }
            }


            /* ---------- CANCEL ---------- */

            else if (key == '*')
            {
                mode = NORMAL_MODE;

                count = 0;

                LCD_command(0x01);
            }


            /* ---------- CONFIRM ---------- */

            else if (key == '#')
            {

                /* =========================
                 * SET TIME
                 * ========================= */

                else if (
                    (mode == TIME_MODE) &&
                    (count == 4u)
                   )
                {
                    value1 =
                        digits[0] * 10u +
                        digits[1];

                    value2 =
                        digits[2] * 10u +
                        digits[3];


                    if (
                        (value1 < 24u) &&
                        (value2 < 60u)
                       )
                    {
                        RTC_set(
                            value1,
                            value2,
                            0,
                            rtc_date,
                            rtc_month,
                            rtc_year
                        );

                        mode = NORMAL_MODE;

                        count = 0;

                        LCD_command(0x01);
                    }
                }


                /* =========================
                 * SET DATE
                 * ========================= */

                else if (
                    (mode == DATE_MODE) &&
                    (count == 6u)
                        )
                {
                    value1 =
                        digits[0] * 10u +
                        digits[1];

                    value2 =
                        digits[2] * 10u +
                        digits[3];

                    value3 =
                        digits[4] * 10u +
                        digits[5];


                    if (
                        (value1 >= 1u) &&
                        (value1 <= 31u) &&
                        (value2 >= 1u) &&
                        (value2 <= 12u)
                       )
                    {
                        RTC_set(
                            rtc_hour,
                            rtc_minute,
                            rtc_second,
                            value1,
                            value2,
                            value3
                        );

                        mode = NORMAL_MODE;

                        count = 0;

                        LCD_command(0x01);
                    }
                }


                /* =========================
                 * SET ALARM
                 * ========================= */

                else if (
                    (mode == ALARM_MODE) &&
                    (count == 4u)
                        )
                {
                    value1 =
                        digits[0] * 10u +
                        digits[1];

                    value2 =
                        digits[2] * 10u +
                        digits[3];


                    if (
                        (value1 < 24u) &&
                        (value2 < 60u)
                       )
                    {
                        alarm_hour = value1;

                        alarm_minute = value2;


                        RTC_alarm_set(
                            alarm_hour,
                            alarm_minute
                        );


                        LCD_command(0x01);

                        LCD_command(0x80);
                        LCD_text("ALARM SET");

                        LCD_command(0xC0);

                        LCD_two(alarm_hour);

                        LCD_data(':');

                        LCD_two(alarm_minute);


                        delay_ms(700);


                        mode = NORMAL_MODE;

                        count = 0;

                        LCD_command(0x01);
                    }
                }
            }
        }


        /* Don't slow down passive buzzer */
        if (!alarm_active)
        {
            delay_ms(50);
        }
    }
}
